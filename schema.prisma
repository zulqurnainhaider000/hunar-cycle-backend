datasource db {
  provider = "postgresql"
  url      = "postgresql://neondb_owner:npg_VMs6ximrJGF9@ep-noisy-sound-b5z8lptr-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=45"
}

generator client {
  provider  = "prisma-client-py"
  interface = "sync" // Using sync interface for standard Flask routes
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  level        Int      @default(1)
  xp           Int      @default(0)
  coins        Int      @default(0)
  loginStreak  Int      @default(0)
  lastLogin    DateTime?
  totalZenMinutes Int   @default(0)
  createdAt DateTime @default(now())

  // Email Verification & OTP Security
  isVerified      Boolean   @default(false)
  otpCode         String?
  otpExpiresAt    DateTime?
  lastOtpSentAt   DateTime?

  // Profile details
  avatarUrl       String?
  location        String?   @default("Islamabad, PK")
  headline        String?   @default("Creative Technologist & Learner")
  role            String    @default("student")

  gigs      Gig[]    @relation("PostedGigs")
  matches1  Matchmaking[] @relation("User1")
  matches2  Matchmaking[] @relation("User2")
  acceptedGigs Gig[] @relation("AcceptedGigs")

  createdEvents Event[] @relation("CreatedEvents")
  attendingEvents Event[] @relation("EventAttendees")
  
  createdTurfs Turf[] @relation("CreatedTurfs")
  memberTurfs Turf[] @relation("TurfMembers")
}

model Gig {
  id          String   @id @default(uuid())
  title       String
  description String
  category    String   @default("GENERAL") // e.g., DEV, SWAP, DESIGN
  rewardCoins Int      @default(0)
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  
  posterId    String
  poster      User     @relation("PostedGigs", fields: [posterId], references: [id])
  
  acceptedById String?
  acceptedBy   User?   @relation("AcceptedGigs", fields: [acceptedById], references: [id])
}

model Matchmaking {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  status    String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  
  user1     User     @relation("User1", fields: [user1Id], references: [id])
  user2     User     @relation("User2", fields: [user2Id], references: [id])
}

model DojoEvent {
  id        String   @id @default(uuid())
  category  String
  player1Id String
  player2Id String
  winnerId  String?
  duration  Int      // in seconds
  createdAt DateTime @default(now())
}

model Lesson {
  id          String      @id @default(uuid())
  title       String
  category    String
  description String?
  color       String      @default("#3B82F6")
  createdAt   DateTime    @default(now())
  
  flashcards  Flashcard[]
  steps       LessonStep[]
  quizzes     Quiz[]
}

model LessonStep {
  id          String   @id @default(uuid())
  lessonId    String
  order       Int      @default(0)
  title       String
  content     String
  codeSnippet String?
  
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  flashcards  Flashcard[]
  quizzes     Quiz[]
}

model Quiz {
  id           String      @id @default(uuid())
  question     String
  options      String[]
  correctAnswer String
  explanation  String?
  lessonId     String
  lessonStepId String?
  createdAt    DateTime    @default(now())
  
  lesson       Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonStep   LessonStep? @relation(fields: [lessonStepId], references: [id], onDelete: Cascade)
}

model Flashcard {
  id          String   @id @default(uuid())
  question    String
  answer      String
  lessonId    String
  lessonStepId String?
  
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonStep  LessonStep? @relation(fields: [lessonStepId], references: [id], onDelete: Cascade)
}

model UserLessonProgress {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String
  unlockedDay Int      @default(1)
  updatedAt   DateTime @default(now())

  @@unique([userId, lessonId])
}

model UserProgress {
  id          String   @id @default(uuid())
  userId      String
  flashcardId String
  rating      String   // "Hard", "Good", "Easy"
  nextReview  DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  location    String
  date        DateTime
  color       String   @default("#10B981")
  createdAt   DateTime @default(now())
  
  accessCode     String?  @default("FREE")
  isLocked       Boolean  @default(false)
  youtubeVideoId String?
  status         String   @default("active") // "active", "ended"
  
  creatorId   String
  creator     User     @relation("CreatedEvents", fields: [creatorId], references: [id])
  
  attendees   User[]   @relation("EventAttendees")
}

model LiveClass {
  id                    String   @id @default(uuid())
  courseTitle           String
  title                 String
  instructorName        String
  instructorTitle       String?
  instructorAvatar      String?
  instructorId          String?
  liveRoomUrl           String?
  youtubeVideoId        String?
  accessCode            String?   @default("FREE")
  isLocked              Boolean   @default(false)
  status                String    @default("active") // "active", "ended"
  enrolledCount         String    @default("+60")
  duration              String    @default("2h+ Hours")
  tag                   String    @default("Live Class")
  badgeText             String    @default("Live Class")
  interactiveBadgeTitle String    @default("Live Interactive")
  interactiveBadgeSub   String    @default("Q&A+ Feedback")
  currentTopic          String?
  description           String?
  scheduledTime         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Turf {
  id          String   @id @default(uuid())
  name        String
  description String
  color       String   @default("#8B5CF6")
  createdAt   DateTime @default(now())
  
  creatorId   String
  creator     User     @relation("CreatedTurfs", fields: [creatorId], references: [id])
  
  members     User[]   @relation("TurfMembers")
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("info") // info, warning, success
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemConfig {
  id                 String   @id @default("default_config")
  quizPassXp         Int      @default(50)
  labCompletionXp    Int      @default(100)
  dailyStreakCoins   Int      @default(10)
  arenaWinCoins      Int      @default(25)
  arenaWinXp         Int      @default(30)
  perfectQuizBonusXp Int      @default(25)
  updatedAt          DateTime @updatedAt
}


